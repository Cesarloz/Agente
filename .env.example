# Docker Compose starts with generated API/encryption secrets in a persistent volume.
# Provider keys are entered in Streamlit and encrypted by FastAPI in PostgreSQL.
# The independent superuser password is generated once; see README to retrieve and change it.
POSTGRES_PASSWORD=agente_local
API_PORT=8000
ADMIN_PORT=8501
PUBLIC_BASE_URL=http://localhost:8000
FORWARDED_ALLOW_IPS=127.0.0.1
URL_ALLOWED_HOSTS=
GRAPH_API_VERSION=v23.0
VECTOR_PROVIDER=chroma
AUTH_SESSION_SECONDS=28800
# Native development only (generate locally; never commit real secrets):
# ADMIN_TOKEN=
# ENCRYPTION_KEY=
# DATABASE_URL=postgresql+psycopg://agente:agente_local@localhost:5432/agente
# CHROMA_HOST=localhost
# CHROMA_PORT=8001
# STORAGE_DIR=storage
# If omitted, native startup generates storage/.auth/initial_password (private file).
# SUPERUSER_PASSWORD_HASH=
# SUPERUSER_PASSWORD_HASH_FILE=
